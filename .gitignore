# --- Secrets ---
.env

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
env/
*.egg-info/

# --- Data (raw data can be large / regenerated; keep it out of git) ---
data/raw/*.csv
data/processed/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- OS / editor junk ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Power BI (large binary files shouldn't live in git) ---
*.pbix.bak
